# Backend Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database
DATABASE_URL=sqlite:////app/data/app.db

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-key-change-this-12345

# MQTT Configuration
# For local: use test.mosquitto.org
# For AWS: use your AWS IoT endpoint
AWS_IOT_ENDPOINT=test.mosquitto.org
MODE=mock

# AWS Configuration (for S3/DynamoDB)
AWS_REGION=us-east-1
AWS_S3_BUCKET=local-images
AWS_DYNAMODB_TABLE=image_events
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Capture Script
CAPTURE_SCRIPT_PATH=/app/capture.py

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
REDIRECT_URL=http://localhost:8080/auth/callback
